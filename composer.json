{
    "name": "drupal/thron",
    "description": "Allows publishers to embed multimedia content from the THRON Intelligent DAM into Drupal",
    "type": "drupal-module",
    "homepage": "https://drupal.org/project/thron",
    "authors": [{
        "name": "THRON Integrations Team",
        "email": "integrations@thron.com",
        "role": "Maintainer"
    }],
    "support": {
        "issues": "https://drupal.org/project/issues/thron",
        "source": "https://git.drupalcode.org/project/thron"
    },
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
		"composer/installers": "~1.0",
        "drupal/entity_browser": "~2.1",
        "drupal/entity_embed": "^1.0",
        "drupal/media_entity_browser": "^2.0"
    },
	"extra": {
        "installer-paths": {
            "modules/custom/{$name}": ["drupal/thron"]
        }
    }
}